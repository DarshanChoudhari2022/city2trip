# Documentation only. For local development put these in .dev.vars.
# Run npm run setup:admin to generate local-only credentials without printing them.
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
SESSION_SECRET=
# Public Web3Forms form identifier; passed only to the booking component.
WEB3FORMS_ACCESS_KEY=
# Optional Google Search Console HTML verification token (token only, not the full tag).
GOOGLE_SITE_VERIFICATION=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=city2trip-media
